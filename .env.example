# Copy to .env (git-ignored). Never commit real values.

# Ronin Waypoint (Ronin Developer Console -> your app -> Wallet & Authentication -> Client ID)
# Baked into the client bundle at build time. Leave unset to use the paste-address fallback.
VITE_WAYPOINT_CLIENT_ID=

# Sky Mavis API key (Ronin Developer Console -> your app -> Information tab -> API key)
# Server-side only. Used for Axie inventory + ownership lookups via
# https://api-gateway.skymavis.com/graphql/axie-marketplace
SKYMAVIS_API_KEY=

# Optional. Ronin mainnet = 2020 (default). Saigon testnet = 2021.
# VITE_WAYPOINT_CHAIN_ID=2020

# Optional. Show cast seed posts in the Global feed (recommended for judging).
# SEED_POSTS=1

# One-Axie R1 loop (client flag; baked at build time)
VITE_BUDDY=1
# BUDDY=0  # server: disable the buddy API

# The Axie's voice model (Google AI Studio key, free tier). Server-side only; on the Worker:
#   npx wrangler secret put GEMINI_API_KEY
# Without it the written line library speaks and photos are not looked at.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Typed chat with the Axie is off for R1 (the Axie speaks after photos). Both halves to turn it on:
# Typed chat is off in Round 1 (the owner's call): the Axie speaks on photos and when patted.
# VITE_TALK=1   client: the Talk button and screen (baked at build time)
# TALK=1        server: the /api/buddy/talk route
# Eggs (hatch your own Axie) are off in Round 1: every Axie is a real one. Set both to 1 to bring them back.
EGGS=0
# VITE_EGGS=1

# Ronin sign-in, "Bring your own Axie", the Profile screen and the diary are off in Round 1:
# nothing connects to a wallet and people pick any real Axie. Set to 1 to bring them back.
# VITE_RONIN=1
